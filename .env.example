# Environment for the Docker stack (docker-compose.yml).
# Copy to .env or let ./start.sh create it; ./start.sh fills the empty secrets.

# Laravel application key. Generated by ./start.sh on first run.
APP_KEY=
APP_ENV=local
APP_DEBUG=false
LOG_LEVEL=info

# PostgreSQL. Only reachable inside the Docker network; no host port is published.
DB_DATABASE=startkey
DB_USERNAME=startkey
DB_PASSWORD=

# Published host ports.
WEB_PORT=3000
API_PORT=8080

# Owner of the bind-mounted ./api directory, used for the php-fpm user.
HOST_UID=1000
HOST_GID=1000

# Reonix entry point behind the header/footer CRM buttons. Empty until the Reonix
# integration is defined; see docs/TECHNICAL_DEBT.md.
NEXT_PUBLIC_REONIX_URL=
REONIX_BASE_URL=
REONIX_PORTAL_KEY=
REONIX_NETWORK_SLUG=startkey

# Google reCAPTCHA v2 for the newsletter form.
#
# The site key below is the public one the reference website renders, so the newsletter
# section looks and behaves exactly like the reference out of the box. A site key is
# public by design and is not a credential.
#
# The matching secret is private, so it is empty here and the API skips the server-side
# verification: the widget is a UI-level check only, and the endpoint relies on its rate
# limit. Fill both with your own reCAPTCHA keys to get real verification.
# Leaving the site key empty renders the form without the widget, 94px shorter than the
# reference. See docs/TECHNICAL_DEBT.md.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LdPsykrAAAAAH4uoUpDaxiGFqNym-ejA_kDzZiE
RECAPTCHA_SECRET_KEY=

# API start: seed runs only when cms_listings is empty. Set 1 to force a full
# re-seed (idempotent updateOrCreate). Leave empty on live servers.
FORCE_DB_SEED=
