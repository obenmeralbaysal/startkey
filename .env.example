# Environment for the Docker stack (docker-compose.yml).
# Copy to .env or let ./start.sh create it; ./start.sh fills the empty secrets.

# Laravel application key. Generated by ./start.sh on first run.
APP_KEY=
APP_ENV=local
APP_DEBUG=false
LOG_LEVEL=info

# PostgreSQL. Only reachable inside the Docker network; no host port is published.
DB_DATABASE=startkey
DB_USERNAME=startkey
DB_PASSWORD=

# Published host ports.
WEB_PORT=3000
API_PORT=8080

# Owner of the bind-mounted ./api directory, used for the php-fpm user.
HOST_UID=1000
HOST_GID=1000

# Reonix entry point behind the header/footer CRM buttons. Empty until the Reonix
# integration is defined; see docs/TECHNICAL_DEBT.md.
NEXT_PUBLIC_REONIX_URL=
REONIX_BASE_URL=
REONIX_PORTAL_KEY=
REONIX_NETWORK_SLUG=startkey
REONIX_MEDIA_CACHE_TTL=21600
# 1 renders /portal/network from local fixtures. Leave empty outside screenshots.
NEXT_PUBLIC_PORTAL_NETWORK_MOCK=

# Google reCAPTCHA v3. One key pair covers every public form. Leave both values
# empty to skip verification and rely on the rate limit. The badge is hidden;
# each form shows Google's required notice instead.
# RECAPTCHA_V3_MIN_SCORE is the lowest accepted score from 0 to 1.
#
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY and RECAPTCHA_SECRET_KEY are unused. They stay
# so an existing environment file keeps the same variable names.
# See docs/TECHNICAL_DEBT.md.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V3_MIN_SCORE=0.5

# Office map base layer. Empty or "default" keeps OpenStreetMap (no key).
# "satellite" uses the URL below only when that URL is non-empty; otherwise
# the map stays on OpenStreetMap. Attribution is shown with the satellite layer.
# NEXT_PUBLIC_* values are inlined when the web image is built.
# The URL may contain a provider token. Leave it empty in the repo and set it
# only in the deploy environment. Do not commit a real token.
NEXT_PUBLIC_MAP_STYLE=
NEXT_PUBLIC_MAP_SATELLITE_URL=
NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=

# API start: seed runs only when cms_listings is empty. Set 1 to force a full
# re-seed (idempotent updateOrCreate). Leave empty on live servers.
FORCE_DB_SEED=
